# ─────────────────────────────────────────────────────────────
# Lost & Found Portal — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=development          # change to "production" on Render
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── Aiven MySQL (Free Tier) ───────────────────────────────────
# Get these values from: Aiven Console → your MySQL service → Overview
DB_HOST=mysql-xxxxxxx-xxxx.aivencloud.com
DB_PORT=3306
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=YOUR_AIVEN_PASSWORD

# Download ca.pem from the Aiven console (Connection Info → Download CA cert)
DB_SSL_CA=/path/to/ca.pem

# Optional — only needed if you enable mTLS in Aiven
# DB_SSL_CERT=/path/to/client-cert.pem
# DB_SSL_KEY=/path/to/client-key.pem

# Connection pool
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=10

# ── Cloudinary (Image Storage — Free tier: 25GB) ──────────────
# Get from: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=lnf

# ── Flask-SocketIO (Real-time Chat) ───────────────────────────
# Leave as default for local dev; configure for production if needed
SOCKETIO_ASYNC_MODE=threading

# ── Optional — Google OAuth ────────────────────────────────────
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxx
